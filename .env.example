# Optional: only needed if using API-key billing instead of subscription/OAuth login.
# Any keys set here are forwarded to containers automatically when the container is created.
# Claude Code subscription users can use `just login <name>` instead.
# Prime Agent users can also launch `just prime <name>` and run `/login` interactively.

# Common providers
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# PRIME_API_KEY=
# OPENROUTER_API_KEY=

# Additional Prime Agent providers
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# ZAI_API_KEY=
# AI_GATEWAY_API_KEY=
# HF_TOKEN=
# FIREWORKS_API_KEY=
# KIMI_API_KEY=
# MOONSHOT_API_KEY=
# OPENCODE_API_KEY=

# Cloudflare providers
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=

# Prime Inference team routing, if applicable
# PRIME_TEAM_ID=
